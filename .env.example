# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 GitHub에 올라가지 않습니다)
# Vercel에는 Settings → Environment Variables 에 같은 이름으로 등록합니다.
# Supabase 키가 비어 있으면 목업 데이터로 동작합니다.

# Supabase (cjb Project, ap-northeast-2)
NEXT_PUBLIC_SUPABASE_URL=https://sforkxsrudzidwdjoisw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # Supabase → Project Settings → API Keys → anon / publishable
SUPABASE_SERVICE_ROLE_KEY=              # 서버 전용(주문·인증 저장). 절대 NEXT_PUBLIC_ 붙이지 말 것
# USE_MOCK=1                            # 키가 있어도 목업 데이터로 보고 싶을 때

# AI (Vercel 팀 공유 변수로 이미 등록됨)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-flash

# 관리자 계정: 회사 메일 도메인만 관리자로 허용 (개인 테스트 계정은 '테스트'로 표시하면 예외)
# ADMIN_EMAIL_DOMAINS=icjb.com
